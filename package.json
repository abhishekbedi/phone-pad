{
  "name": "@tentronix/phonepad",
  "version": "1.0.0",
  "description": "PhonePad — turn your phone into a wireless trackpad for your Mac, Windows, or Linux computer",
  "main": "server/index.js",
  "type": "module",
  "license": "MIT",
  "author": "Abhishek Bedi",
  "repository": {
    "type": "git",
    "url": "https://github.com/abhishekbedi/phone-pad.git"
  },
  "homepage": "https://github.com/abhishekbedi/phone-pad#readme",
  "bugs": {
    "url": "https://github.com/abhishekbedi/phone-pad/issues"
  },
  "keywords": [
    "trackpad",
    "remote-mouse",
    "touchpad",
    "pwa",
    "websocket",
    "gesture",
    "multitouch",
    "cross-platform"
  ],
  "scripts": {
    "test": "bash tests/e2e-server.sh",
    "start": "launchctl bootout gui/$(id -u)/nz.tentronix.phonepad 2>/dev/null; lsof -ti:8888 | xargs kill -9 2>/dev/null; sleep 0.5; node server/index.js",
    "dev": "launchctl bootout gui/$(id -u)/nz.tentronix.phonepad 2>/dev/null; lsof -ti:8888 | xargs kill -9 2>/dev/null; sleep 0.5; node server/index.js --dev",
    "build": "node-gyp rebuild",
    "install": "node-gyp rebuild || echo 'Native addon build failed — fallback mode will be used'",
    "service:install": "node scripts/install-service.mjs && launchctl load ~/Library/LaunchAgents/nz.tentronix.phonepad.plist",
    "service:uninstall": "launchctl unload ~/Library/LaunchAgents/nz.tentronix.phonepad.plist && rm ~/Library/LaunchAgents/nz.tentronix.phonepad.plist",
    "service:start": "launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/nz.tentronix.phonepad.plist",
    "service:stop": "launchctl bootout gui/$(id -u)/nz.tentronix.phonepad",
    "service:restart": "launchctl kickstart -k gui/$(id -u)/nz.tentronix.phonepad",
    "service:status": "launchctl list | grep phonepad",
    "service:logs": "tail -f logs/server.log"
  },
  "dependencies": {
    "ws": "8.21.0",
    "qrcode": "1.5.4",
    "node-addon-api": "8.3.0"
  },
  "devDependencies": {
    "node-gyp": "latest"
  }
}
